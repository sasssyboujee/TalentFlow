{
  "manifest_version": 3,
  "name": "TalentFlow",
  "version": "1.0.0",
  "description": "Scrapes and sends job postings directly to your AutoJob-Agent tracker and AI pipeline.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
